# Host directory mounted into the app container as /media.
# Keep /media on Orange Pi so absolute host paths remain identical in Docker.
HOST_MEDIA_ROOT=/media

# auto: enable RK3588 devices when /dev/mpp_service, /dev/rga and /dev/mali0 exist.
# Set to 1 to require the Orange Pi override, or 0 to disable it.
RPI_MAINPAGE_USE_OPI=auto

# Dynamic HLS limits and quality.
MEDIA_H264_BITRATE=6000k
MEDIA_HLS_SEGMENT_SECONDS=4
MEDIA_HLS_BATCH_SEGMENTS=4
MEDIA_SEGMENT_WAIT_SECONDS=30
MEDIA_WORKER_IDLE_SECONDS=15
MEDIA_MAX_SESSIONS=3
MEDIA_SESSION_TTL_SECONDS=1800

# PHP-FPM runtime identity inside the container.
APP_RUN_USER=ubuntu
APP_RUN_GROUPS=www-data
